import java.util.*;
import java.io.*;
/**
*@autor Alison Ramirez
*Java Loops II
*/
class Solution{
    public static void main(String []argh){
        Scanner in = new Scanner(System.in);
        int t=in.nextInt();
        if( t >= 0 && t <= 500){
            for(int i=0;i<t;i++){
                int a = in.nextInt();
                int b = in.nextInt();
                int n = in.nextInt();
                int result=a;
                if(a >= 0 && a <= 50 && b >= 0 && b <= 50 && n >= 1 && n <= 15 ){
                    for(int j = 0; j < n ;  j++ ){
                        result+= (int)Math.pow(2, j) * b;
                        System.out.print(result + " ");
                    }
                }else{
                System.out.println("Los valores ingresados para a, b y n se encuentran fuera del rango establecido");
                }
                System.out.println();
            }
        }else{
            System.out.printl("El valor ingresado para t se encuentra fuera del rango establecido ");
        }
        in.close();
    }
}
